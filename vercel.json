{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.hipokratia.health https://hipokratia.health https://*.icarticular.cl https://icarticular.cl"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "conoce.icarticular.cl"
        }
      ],
      "destination": "/ica.html"
    }
  ]
}
